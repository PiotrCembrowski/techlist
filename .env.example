# ── Database ────────────────────────────────────────────────────────────────
# Local: `pnpm db:up` starts PostgreSQL 16 via Docker Compose with these credentials.
DATABASE_URL=postgres://specbase:specbase@localhost:5432/specbase
# Used by integration tests and e2e runs. Its schema is DROPPED and recreated by the test setup.
TEST_DATABASE_URL=postgres://specbase:specbase@localhost:5432/specbase_test
DB_POOL_MAX=10

# ── Site ────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000

# ── Demo data ───────────────────────────────────────────────────────────────
# Shows the site-wide "Demonstration data" banner and lets demo offers redirect.
ENABLE_DEMO_DATA=true
# The demo seed refuses to run when NODE_ENV=production unless this is true.
ALLOW_DEMO_SEED=false

# ── Offers ──────────────────────────────────────────────────────────────────
# Offers whose last check is older than this are shown as stale.
OFFER_STALE_HOURS=72
# A price more than this fraction away from the product's median current price (same currency)
# creates a "suspicious_price" review item. 0.5 = 50%.
SUSPICIOUS_PRICE_DEVIATION=0.5

# ── Auth ────────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32   (never commit a real value)
AUTH_SECRET=

# ── Uploads (product images, brand logos) ───────────────────────────────────
# local: files under STORAGE_LOCAL_DIR (development). s3: any S3-compatible store (production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=          # e.g. https://<account>.r2.cloudflarestorage.com for S3-compatible stores
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Data provider adapters (optional; see docs/DATA_SOURCES.md) ───────────────────────
# Leave unset unless you have an agreement with the provider. Never commit real keys.
# MANUFACTURER_FILES_DIR=
# LICENSED_FEED_URL=
# LICENSED_FEED_API_KEY=
# AFFILIATE_FEED_URL=
# AFFILIATE_FEED_API_KEY=

# Reverse proxies in front of the app that append to X-Forwarded-For (rate limits use the client
# address that many hops from the end). 1 = one proxy (Vercel, Caddy, nginx). 0 = ignore the header.
# TRUSTED_PROXY_HOPS=1
